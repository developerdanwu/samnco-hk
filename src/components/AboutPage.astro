---
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import shopfront from "../assets/map-banner-2500.jpg";
import { m } from "../paraglide/messages.js";
---
<Base title={m.meta_title_about()}>
  <main class="mx-auto grid max-w-6xl gap-10 px-5 py-10 md:grid-cols-[1fr_1.15fr] md:items-start md:gap-16 md:px-14 md:py-16">
    <Image
      src={shopfront}
      alt=""
      widths={[500, 800, 1200]}
      sizes="(min-width: 768px) 40vw, 100vw"
      class="aspect-3/2 w-full object-cover"
    />
    <div class="flex flex-col gap-5">
      <h1 class="font-serif text-[34px] leading-[1.1] font-light md:text-5xl">{m.about_title()}</h1>
      <div class="text-paper-700 flex flex-col gap-4 text-base leading-[1.75]">
        <p>{m.about_p1()}</p>
        <p>{m.about_p2()}</p>
        <p>{m.about_p3()}</p>
        <p>{m.about_p4()}</p>
      </div>
    </div>
  </main>
</Base>

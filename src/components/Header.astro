---
import { Image } from "astro:assets";
import logo from "../assets/logo.png";
import Nav from "./Nav.tsx";
import { m } from "../paraglide/messages.js";
import { getLocale, localizeHref } from "../paraglide/runtime.js";

const locale = getLocale() as "en" | "zh-hk";
const path = Astro.url.pathname;
const de = (p: string) => p.replace(/^\/zh-hk/, "") || "/";
const here = de(path);

const links = [
  { label: m.nav_home(), href: localizeHref("/"), current: here === "/" },
  { label: m.nav_about(), href: localizeHref("/about"), current: here.startsWith("/about") },
  { label: m.nav_shop(), href: localizeHref("/shop"), current: here.startsWith("/shop") || here.startsWith("/detail") },
  // "Visit" is an anchor to the footer, not a page — the same as the original site's CONTACT.
  // Inventing a page here would be scope the migration did not ask for.
  { label: m.nav_visit(), href: "#visit", current: false },
];
const localeHrefs = {
  en: localizeHref(here, { locale: "en" }),
  "zh-hk": localizeHref(here, { locale: "zh-hk" }),
};
---
<header class="border-paper-300 border-b">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-6 px-5 py-4 md:px-14 md:py-7">
    <!-- 三和文藝公司 leads; the English name is the secondary line (issue 05). -->
    <a href={localizeHref("/")} class="flex items-center gap-3 md:gap-3.5">
      <Image src={logo} alt="" width={38} height={38} class="size-7.5 md:size-9.5" />
      <span class="flex flex-col gap-0.5">
        <span class="font-hk text-lg leading-none font-semibold md:text-2xl">三和文藝公司</span>
        <span class="text-paper-650 text-[9px] tracking-[0.18em] uppercase md:text-[11px] md:tracking-[0.2em]">
          Sam &amp; Company{" "}<span class="hidden md:inline">· since 1980</span>
        </span>
      </span>
    </a>

    <div class="flex items-center gap-6">
      <nav class="hidden items-center gap-7 text-xs tracking-[0.13em] uppercase md:flex">
        {links.map((l) => (
          <a
            href={l.href}
            aria-current={l.current ? "page" : undefined}
            class:list={["py-0.5", l.current && "border-brand-500 border-b-2"]}
          >
            {l.label}
          </a>
        ))}
      </nav>
      <Nav
        client:load
        links={links}
        locale={locale}
        localeHrefs={localeHrefs}
        whatsapp="+852 9721 9032"
        address={m.address_full()}
        hours={m.status_hours_summary()}
      />
    </div>
  </div>
</header>

---
import "../styles/global.css";
import { getLocale } from "../paraglide/runtime.js";
import { m } from "../paraglide/messages.js";

interface Props { title?: string }
const { title } = Astro.props;
const locale = getLocale();
---
<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Newsreader:opsz,wght@6..72,300;6..72,400;6..72,500&family=Karla:wght@400;500;600&family=Noto+Serif+HK:wght@300;400;600&display=swap"
    />
    <title>{title ?? m.meta_title_home()}</title>
    <meta name="description" content={m.meta_desc()} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
  </head>
  <body>
    <slot />
  </body>
</html>

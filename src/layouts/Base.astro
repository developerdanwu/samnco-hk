---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { m } from "../paraglide/messages.js";
import { getLocale } from "../paraglide/runtime.js";
import { getAllProducts, getCategoryCounts } from "../lib/contentful.ts";

interface Props { title?: string; description?: string }
const { title, description } = Astro.props;

// Cached per process, so ~700 prerendered pages fetch the catalogue once.
const [products, counts] = await Promise.all([getAllProducts(), getCategoryCounts()]);
---
<!doctype html>
<html lang={getLocale()}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title ?? m.meta_title_home()}</title>
    <meta name="description" content={description ?? m.meta_desc()} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />

    <!-- <link>, not an @import in CSS: an @import placed after any rule is silently dropped
         by browsers, and it also serialises the font request behind the stylesheet. -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Newsreader:opsz,wght@6..72,300;6..72,400;6..72,500&family=Karla:wght@400;500;600&family=Noto+Serif+HK:wght@300;400;600&display=swap"
    />
  </head>
  <body class="min-h-dvh">
    <Header />
    <slot />
    <Footer counts={counts} total={products.length} />
  </body>
</html>

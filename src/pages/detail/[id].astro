---
import DetailPage from "../../components/DetailPage.astro";
import NotFoundPage from "../../components/NotFoundPage.astro";
import { getDetailProps } from "../../lib/shop-paths.ts";

export const prerender = false;

// An unpublished or deleted product must 404, not 500. The webhook purges this path on
// publish, so a product added later does not stay 404 behind the cached miss.
const props = await getDetailProps(Astro.params.id!);
if (!props) Astro.response.status = 404;
---
{props ? <DetailPage product={props.product} related={props.related} /> : <NotFoundPage />}
